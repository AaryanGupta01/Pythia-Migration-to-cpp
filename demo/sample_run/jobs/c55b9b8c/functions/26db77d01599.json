{"id": "quanta/text/spell.py::SpellChecker.suggest", "file": "quanta/text/spell.py", "name": "suggest", "qualname": "SpellChecker.suggest", "line": 17, "end_line": 27, "col": 4, "status": "not_eligible", "eligibility": "not_eligible", "reason": "method of class SpellChecker", "decision": "pending", "score": {"total": 0.0, "trace_share": 0.0, "static_heuristic": 0.31, "eligibility_factor": 0.0, "expected_benefit": 13.44, "boundary_penalty": 0.0, "basis": "trace", "notes": ["not called during the traced run -> no measured benefit", "not eligible: method of class SpellChecker"]}, "share": 0.0, "calls": 0, "speedup": null, "probe_speedup": null, "metrics": {"size_lines": 11, "loop_depth": 1, "arith_density": 0.12, "calls": ["abs", "len", "levenshtein", "ord", "zip"], "imports": ["quanta.text.distance"], "uses_globals": []}, "trace": null, "sources": {"original": "    def suggest(self, word: str) -> str:\n        \"\"\"Closest dictionary word by Levenshtein distance; the first in dictionary order wins ties.\"\"\"\n        query = [ord(c) for c in word]\n        best, best_d = word, self.max_distance + 1\n        for candidate, codes in zip(self.dictionary, self.codes):\n            if abs(len(codes) - len(query)) >= best_d:\n                continue\n            d = levenshtein(query, codes)\n            if d < best_d:\n                best, best_d = candidate, d\n        return best", "annotated": null, "pysub": null, "cpp": null, "wrapper_cpp": null}, "line_map_ok": true, "cpp_line_map": {}, "rewrites": [], "diagnostics": [], "fidelity": [], "build": null, "replay": null, "bench": null, "splice": null, "journey": [{"key": "original", "title": "Original Python", "state": "done", "summary": "11 lines", "reason": null}, {"key": "observed_types", "title": "Observed types (trace)", "state": "skipped", "summary": null, "reason": "function was not called during the trace"}, {"key": "eligibility", "title": "Eligibility check", "state": "failed", "summary": null, "reason": "met