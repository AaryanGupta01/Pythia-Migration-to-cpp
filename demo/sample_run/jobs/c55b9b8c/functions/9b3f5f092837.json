{"id": "quanta/graph/sparse.py::Graph.shortest_paths", "file": "quanta/graph/sparse.py", "name": "shortest_paths", "qualname": "Graph.shortest_paths", "line": 29, "end_line": 42, "col": 4, "status": "not_eligible", "eligibility": "not_eligible", "reason": "method of class Graph", "decision": "pending", "score": {"total": 0.0, "trace_share": 0.0, "static_heuristic": 0.4575, "eligibility_factor": 0.0, "expected_benefit": 19.11, "boundary_penalty": 0.0, "basis": "trace", "notes": ["not called during the traced run -> no measured benefit", "not eligible: method of class Graph"]}, "share": 0.0, "calls": 0, "speedup": null, "probe_speedup": null, "metrics": {"size_lines": 14, "loop_depth": 2, "arith_density": 0.1, "calls": ["dist.get", "heapq.heappop", "heapq.heappush", "self.adj[u].items"], "imports": ["heapq"], "uses_globals": []}, "trace": null, "sources": {"original": "    def shortest_paths(self, source: int) -> Dict[int, int]:\n        \"\"\"Distances from `source` to every reachable node (binary-heap Dijkstra).\"\"\"\n        dist: Dict[int, int] = {source: 0}\n        heap = [(0, source)]\n        while heap:\n            d, u = heapq.heappop(heap)\n            if d > dist.get(u, d):\n                continue\n            for v, w in self.adj[u].items():\n                nd = d + w\n                if nd < dist.get(v, nd + 1):\n                    dist[v] = nd\n                    heapq.heappush(heap, (nd, v))\n        return dist", "annotated": null, "pysub": null, "cpp": null, "wrapper_cpp": null}, "line_map_ok": true, "cpp_line_map": {}, "rewrites": [], "diagnostics": [], "fidelity": [], "build": null, "replay": null, "bench": null, "splice": null, "journey": [{"key": "original", "title": "Original Python", "state": "done", "summary": "14 lines", "reason": null}, {"key": "observed_types", "title": "Observed types (trace)", "state": "skipped", "summary": null, "reason": "function was not called during the trace"}, {"key": "eligibility", "title": "Eligibility che