{"id": "quanta/text/index.py::InvertedIndex.search", "file": "quanta/text/index.py", "name": "search", "qualname": "InvertedIndex.search", "line": 42, "end_line": 50, "col": 4, "status": "not_eligible", "eligibility": "not_eligible", "reason": "method of class InvertedIndex", "decision": "pending", "score": {"total": 0.0, "trace_share": 0.0, "static_heuristic": 0.45, "eligibility_factor": 0.0, "expected_benefit": 18.82, "boundary_penalty": 0.0, "basis": "trace", "notes": ["not called during the traced run -> no measured benefit", "not eligible: method of class InvertedIndex"]}, "share": 0.0, "calls": 0, "speedup": null, "probe_speedup": null, "metrics": {"size_lines": 9, "loop_depth": 2, "arith_density": 0.12, "calls": ["defaultdict", "scores.items", "self.idf", "self.postings.get", "self.postings.get(term, {}).items", "set", "sorted", "tokenize"], "imports": ["collections"], "uses_globals": []}, "trace": null, "sources": {"original": "    def search(self, query: str, limit: int = 5) -> List[int]:\n        \"\"\"Ids of the best-matching documents, best first (ties broken by id).\"\"\"\n        scores: Dict[int, float] = defaultdict(float)\n        for term in set(tokenize(query)):\n            weight = self.idf(term)\n            for doc_id, count in self.postings.get(term, {}).items():\n                scores[doc_id] += weight * count / (1 + self.lengths[doc_id]) ** 0.5\n        ranked = sorted(scores.items(), key=lambda kv: (-kv[1], kv[0]))\n        return [doc_id for doc_id, _ in ranked[:limit]]", "annotated": null, "pysub": null, "cpp": null, "wrapper_cpp": null}, "line_map_ok": true, "cpp_line_map": {}, "rewrites": [], "diagnostics": [], "fidelity": [], "build": null, "replay": null, "bench": null, "splice": null, "journey": [{"key": "original", "title": "Original Python", "state": "done", "summary": "9 lines", "reason": null}, {"key": "observed_types", "title": "Observed types (trace)", "state": "skipped", "summary": null, "reason": "function was not called du